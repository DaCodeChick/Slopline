{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (system compiler, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan",
      "displayName": "GCC + AddressSanitizer/UBSan",
      "inherits": "gcc",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "HOTLINE_SANITIZE": "ON"
      }
    },
    {
      "name": "static",
      "displayName": "GCC, monolithic STATIC AppWarrior (BUILD_SHARED_LIBS=OFF)",
      "inherits": "gcc",
      "binaryDir": "${sourceDir}/build/static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "modular",
      "displayName": "GCC, per-component shared AppWarrior (BUILD_MONOLITHIC=OFF)",
      "inherits": "gcc",
      "binaryDir": "${sourceDir}/build/modular",
      "cacheVariables": {
        "BUILD_MONOLITHIC": "OFF"
      }
    },
    {
      "name": "static-modular",
      "displayName": "GCC, per-component STATIC AppWarrior (BUILD_MONOLITHIC=OFF, BUILD_SHARED_LIBS=OFF)",
      "inherits": "gcc",
      "binaryDir": "${sourceDir}/build/static-modular",
      "cacheVariables": {
        "BUILD_MONOLITHIC": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "gcc",
      "configurePreset": "gcc"
    },
    {
      "name": "clang",
      "configurePreset": "clang"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "static",
      "configurePreset": "static"
    },
    {
      "name": "modular",
      "configurePreset": "modular"
    },
    {
      "name": "static-modular",
      "configurePreset": "static-modular"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "static",
      "configurePreset": "static",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "modular",
      "configurePreset": "modular",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "static-modular",
      "configurePreset": "static-modular",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}